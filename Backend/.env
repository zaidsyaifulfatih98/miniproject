# Supabase PostgreSQL - Connection Pooler (untuk Prisma Client / runtime queries)
# Dapatkan dari: Supabase Dashboard > Project Settings > Database > Connection string > Transaction Pooler
# Ganti [YOUR-PASSWORD] dengan password database Supabase kamu
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL - Direct Connection (untuk Prisma Migrate)
# Dapatkan dari: Supabase Dashboard > Project Settings > Database > Connection string > Session Pooler (port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# JWT Secret
JWT_SECRET="your_jwt_secret_here"

# Port
PORT=8000
